{
  "name": "rexrun-aws-preparation",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "bundle": "esbuild collector/handler.ts --bundle --platform=node --target=node24 --format=cjs --outfile=../.cache/collector/index.js",
    "synth": "npm run bundle && cdk synth --strict --no-lookups --output ../.cache/cdk.out"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1152.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
